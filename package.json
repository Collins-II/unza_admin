  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test tests/*.test.ts",
    "test:bookings": "node --experimental-test-module-mocks --experimental-transform-types --test tests/studentBookings.test.mjs",
    "test:academics": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-test-module-mocks --experimental-transform-types --test tests/academicWorkflows.test.mjs",
    "test:governance": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-test-module-mocks --experimental-transform-types --test tests/governanceWorkflows.test.mjs",
    "mock:students": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/generate-mock-students.mjs",
    "release:check": "node scripts/check-production.mjs",
    "test:live-auth": "node scripts/test-live-auth.mjs"
